{
  "name": "typed-voice",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare:runtime": "node scripts/copy-runtime-assets.mjs",
    "build:kanalizer-wasm": "bash scripts/build-kanalizer-wasm.sh",
    "licenses:kanalizer": "bash scripts/generate-kanalizer-rust-licenses.sh",
    "dev": "npm run prepare:runtime && vite",
    "build": "npm run prepare:runtime && vite build && node scripts/generate-source-asset-map.mjs dist",
    "preview": "vite preview",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "vite": "8.2.1"
  }
}